{
  "expo": {
    "name": "Castar",
    "slug": "castar-app",
    "scheme": "castar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "description": "Personal and family finance tracking for iOS and Android.",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101010"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nilats.castar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Castar uses the microphone to turn voice input into transactions.",
        "NSSpeechRecognitionUsageDescription": "Castar uses speech recognition to convert voice input into transaction text."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101010"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.nilats.castar"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Castar to use Face ID for quick unlock"
        }
      ]
    ],
    "owner": "vladlen",
    "extra": {
      "eas": {
        "projectId": "cab94422-ac9e-4e13-a97b-61aeeb769833"
      }
    }
  }
}
